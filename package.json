{
  "name": "moonverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma migrate deploy && NODE_OPTIONS='--max-http-header-size=1048576' next dev --webpack",
    "dev:large-headers": "prisma migrate deploy && node scripts/next-with-large-headers.mjs --dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "NODE_OPTIONS='--max-http-header-size=1048576' next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:seed": "prisma db seed",
    "db:seed:public": "prisma db seed",
    "demo:generate": "tsx prisma/scripts/generate-demo-dataset.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "demo:load": "npm run demo:generate -- --batch full && npm run prisma:seed:demo",
    "demo:seed:admin-qa": "tsx --env-file=.env prisma/scripts/seed-admin-qa-extension.ts",
    "demo:seed:admin-qa-content": "tsx --env-file=.env prisma/scripts/seed-admin-qa-content.ts",
    "demo:generate:profile-assets": "tsx prisma/scripts/generate-demo-profile-assets.ts",
    "demo:refresh:user-profiles": "tsx --env-file=.env prisma/scripts/refresh-demo-user-profiles.ts",
    "verify:admin-qa": "tsx --env-file=.env scripts/verify-admin-qa-dataset.ts",
    "catalog:export": "tsx prisma/scripts/export-real-world-catalog.ts",
    "db:studio": "prisma studio",
    "test:moonie": "tsx --test src/lib/moonie/guardrails.test.ts src/lib/moonie/preferences.test.ts src/lib/moonie/eval-metrics.test.ts src/lib/moonie/ranking.test.ts src/lib/moonie/preference-schema.test.ts src/lib/moonie/openai.test.ts src/lib/moonie/desk.test.ts src/lib/moonie/file-attachment.test.ts src/lib/moonie/compare-acceptance.test.ts src/lib/moonie/intent-reading-link.test.ts src/lib/moonie/intent-correctness.test.ts src/lib/moonie/user-message-attachment.test.ts src/lib/moonie/conversation-url.test.ts src/services/moonie-vision.service.test.ts",
    "moonie:eval": "tsx scripts/moonie-eval.ts",
    "moonie:reset-quota": "NODE_ENV=development tsx --env-file=.env scripts/reset-moonie-quota.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@react-email/render": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "recharts": "^3.10.1",
    "resend": "^6.24.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
