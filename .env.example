# =============================================================================
# MoonVerse environment variables
# Copy to .env for local development: cp .env.example .env
# Never commit .env — it is gitignored.
# =============================================================================

# --- Required ---

# PostgreSQL connection string (hosted provider in production)
# Local Docker: postgresql://moonverse:moonverse@localhost:5432/moonverse?schema=public
# Neon/Supabase: use the pooled connection string for serverless (Vercel)
# Append ?sslmode=require if your provider requires SSL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moonverse?schema=public"

# Auth.js / NextAuth secret — generate with: openssl rand -base64 32
# Use a unique, strong value in production (never reuse local secrets)
AUTH_SECRET="your-secret-here"

# Canonical site URL (required in production for Auth.js)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# --- Optional ---

# OpenAI API key for Moonie live AI recommendations
# If unset, Moonie uses mock recommendations from MoonVerse data (fine for demos)
# OPENAI_API_KEY="sk-..."

# OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

# Legacy alias — Auth.js v5 prefers AUTH_URL; set both to the same value if unsure
# NEXTAUTH_URL="http://localhost:3000"
