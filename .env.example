# =============================================================================
# MoonVerse environment variables
# Copy to .env for local development: cp .env.example .env
# Never commit .env: it is gitignored.
# =============================================================================

# --- Required ---

# PostgreSQL connection string (hosted provider in production)
# Local Docker (docker-compose.yml): postgresql://moonverse:moonverse@localhost:5433/moonverse?schema=public
# Neon/Supabase: use the pooled connection string for serverless (Vercel)
# Append ?sslmode=require if your provider requires SSL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moonverse?schema=public"

# Auth.js / NextAuth secret: generate with: openssl rand -base64 32
# Use a unique, strong value in production (never reuse local secrets)
AUTH_SECRET="your-secret-here"

# Canonical site URL (required in production for Auth.js)
# Local: http://localhost:3000
# Production: https://moonverse.online (or your deployed app URL)
AUTH_URL="http://localhost:3000"

# Public origin used for Open Graph / metadataBase and email links (falls back to AUTH_URL)
# Production: set to your public site URL, e.g. https://moonverse.online
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: OAuth (Auth.js) ---
# Set credentials, then expose enable flags to the client for login buttons.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="true"
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""
# NEXT_PUBLIC_AUTH_DISCORD_ENABLED="true"

# --- Email (Resend) ---
# Required for real email delivery in production.
# Verified sending domain: moonverse.online (configure DNS in Resend only; do not change from the app).
#
# Production example:
# RESEND_API_KEY="re_..."
# EMAIL_FROM="MoonVerse <no-reply@moonverse.online>"
# AUTH_URL="https://moonverse.online"
# NEXT_PUBLIC_APP_URL="https://moonverse.online"
#
# Development safeguards (production ignores these):
# By default, dev blocks real sends unless you opt in:
#   EMAIL_SEND_IN_DEV="true"  → allow all dev sends
#   EMAIL_DEV_ALLOWLIST="you@gmail.com,teammate@example.com"  → allow listed addresses only
# EMAIL_SEND_IN_DEV="false"
# EMAIL_DEV_ALLOWLIST="you@gmail.com,teammate@example.com"
#
# Require verified email for posting reviews/comments is controlled in Admin → Settings
# (not an environment variable).

# Cron secret for digest / scheduled jobs (Authorization: Bearer …)
# Not required for the six production-ready transactional/auth email flows.
# CRON_SECRET="generate-a-long-random-string"

# --- Optional: Scheduled jobs ---
# Shared secret required by /api/cron/digest (Authorization: Bearer <secret> or ?secret=<secret>)
# Digest and Moonie daily pick emails exist in code but are not production-ready until cron is scheduled.
# CRON_SECRET="generate-a-long-random-value"

# --- Optional: Moonie ---

# Screenshot / image title lookup (OpenAI Vision)
# Without OPENAI_API_KEY, Moonie still accepts images and replies honestly that
# vision is not configured — you can type the title for catalogue lookup instead.
#
# Local dev setup:
#   OPENAI_API_KEY="sk-..."
#   OPENAI_VISION_MODEL="gpt-5.6-terra"
#
# Verify after setting: npx tsx scripts/verify-moonie-vision.ts
# OPENAI_API_KEY="sk-..."

# General Moonie text tasks (preference extraction, explanation polish).
# Defaults to gpt-5.6-luna when unset.
# OPENAI_MODEL="gpt-5.6-luna"

# Vision model for screenshot / cover lookup (defaults to gpt-5.6-terra)
# OPENAI_VISION_MODEL="gpt-5.6-terra"

# Development only — Moonie quota testing (never enable in production)
# MOONIE_DEV_QUOTA_TOOLS=true enables `npm run moonie:reset-quota` locally
# MOONIE_DEV_QUOTA_BYPASS=true also skips the 30/day discovery limit in local dev (optional)

# Real-world novel dataset: prisma/data/real-world-catalog.json
# Regenerate from curated sources: npm run catalog:export
# Full seed (329 novels, 500 reviews): npm run prisma:seed

# Legacy alias: Auth.js v5 prefers AUTH_URL; set both to the same value if unsure
# NEXTAUTH_URL="http://localhost:3000"

# Optional social / contact links (footer only renders links that are set)
# NEXT_PUBLIC_DISCORD_URL="https://discord.gg/..."
# NEXT_PUBLIC_GITHUB_URL="https://github.com/..."
# NEXT_PUBLIC_TWITTER_URL="https://x.com/..."
# NEXT_PUBLIC_BLUESKY_URL="https://bsky.app/profile/..."
# NEXT_PUBLIC_REDDIT_URL="https://reddit.com/r/..."
# NEXT_PUBLIC_CONTACT_EMAIL="hello@moonverse.app"
